# Copie este arquivo para ".env" e preencha. O servidor lê o .env sozinho ao iniciar.

# Porta local (o túnel da Cloudflare aponta para http://localhost:PORT)
PORT=3000

# Opcional: exige um código para criar conta (deixe vazio para cadastro livre)
REGISTER_CODE=

# Recomendado: TURN gratuito da Cloudflare, para a call conectar até pelo 4G / redes chatas.
# Cloudflare → Realtime → TURN Server → Create → copie o "Turn Token ID" e o "API Token".
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Alternativa: seu próprio TURN (coturn etc.)
# TURN_URL=turn:seu-servidor:3478
# TURN_USERNAME=
# TURN_PASSWORD=
