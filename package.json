{
  "name": "kenfeh",
  "version": "1.0.0",
  "description": "Kenfeh — chamadas, chat, figurinhas e compartilhamento de tela em altíssima qualidade.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch server/index.js",
    "db:init": "node --no-warnings=ExperimentalWarning scripts/init-db.js",
    "https": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js --https"
  },
  "dependencies": {
    "express": "^4.22.3",
    "gifenc": "^1.0.3",
    "multer": "^2.5.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.4"
  }
}
